# GitHub Pages website (served separately, not part of package)
docs/

# Generated non-Dart bindings (npm / PyPI / CSV / GeoJSON). They are built
# from the same dataset but published separately; shipping them inside the
# Dart package would add ~1.7 MB of duplicate JSON for no Dart consumer.
bindings/

# Tooling scripts (not needed in published package)
tool/

# Companion Flutter packages. nepal_admin_widgets is published separately and
# depends on THIS package via a path dependency; shipping it inside would add
# the whole widget source plus its pubspec lock to every download.
packages/

# Raw data sources (not needed in published package)
data/_raw/
data/_stage/

# Documentation
doc/

# Temporary files
*.dart_tool/
.packages
pubspec.lock
build/
coverage/

# IDE
.idea/
.vscode/
.DS_Store

# Test files (optional - can be included for reference)
# test/

# Example files (optional - can be included)
# example/